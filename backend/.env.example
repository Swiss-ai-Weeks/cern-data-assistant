# Copy this file to .env and adjust if needed.

# Local Ollama server (default install on macOS)
OLLAMA_HOST=http://localhost:11434
# Any model you've pulled with `ollama pull <model>`.
# Good local choices on an M1 Mac: llama3.2, qwen2.5:7b, mistral
OLLAMA_MODEL=llama3.2
# Embedding model for the RAG knowledge base (pull it on the H100).
OLLAMA_EMBED_MODEL=nomic-embed-text

# CERN Open Data REST API
CERN_API_BASE=https://opendata.cern.ch/api/records/

# Flask server port. 5000 is avoided on purpose: on macOS it collides with
# the AirPlay Receiver service, which is a classic source of confusion.
PORT=5001

# --- RAG / guardrail / deployment ------------------------------------------
# Used when OLLAMA_MODEL is not pulled on the Ollama host (never blocks a demo).
OLLAMA_FALLBACK_MODEL=llama3.2
# Passages retrieved per question.
RAG_TOP_K=6
# Retrieval gate: best cosine below this -> refuse without calling the LLM.
# Calibrated on nomic-embed-text: on-topic questions score >= 0.75, off-topic <= 0.58.
RAG_MIN_SCORE=0.65
# Between RAG_MIN_SCORE and RAG_MIN_SCORE+margin -> answer but flag "low confidence".
RAG_LOW_CONF_MARGIN=0.05
# 1 = Flask serves frontend/dist on the same port (H100 deployment); 0 = API only.
SERVE_FRONTEND=0
# 1 = Flask debug/reloader (laptop dev); 0 on the H100.
FLASK_DEBUG=1
# A passage must score at least this to be citable.
RAG_MIN_CITE_SCORE=0.45
# Repeat CERN Open Data searches are cached this many seconds (demo speed).
CERN_CACHE_TTL=300
