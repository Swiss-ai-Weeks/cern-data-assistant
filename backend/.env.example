# Copy this file to .env and adjust if needed.

# Local Ollama server (default install on macOS)
OLLAMA_HOST=http://localhost:11434
# Any model you've pulled with `ollama pull <model>`.
# Good local choices on an M1 Mac: llama3.2, qwen2.5:7b, mistral
OLLAMA_MODEL=llama3.2

# CERN Open Data REST API
CERN_API_BASE=https://opendata.cern.ch/api/records/

# Flask server port. 5000 is avoided on purpose: on macOS it collides with
# the AirPlay Receiver service, which is a classic source of confusion.
PORT=5001
